# Generate a private value: openssl rand -hex 32
WORKSPACE_TOKEN=
# Native Go development only; Compose supplies its own internal database URL.
DATABASE_URL=postgres://close:local-development-only@127.0.0.1:5432/close?sslmode=disable
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional hosted login. When enabled, the development token is not accepted.
WORKOS_CLIENT_ID=
WORKOS_API_HOSTNAME=
# Optional single-organization restriction and legacy sandbox owner.
# Leave empty for multi-firm SaaS; register allowed organizations in the database.
WORKOS_ORGANIZATION_ID=
# Exact iss claim configured for your WorkOS application; do not guess.
WORKOS_ISSUER=
# Sandbox only; obtain a short-lived access token from the Intuit developer playground.
# Expired tokens stop operations; this initial sandbox slice does not refresh OAuth tokens.
QBO_SANDBOX_REALM_ID=
QBO_SANDBOX_ACCESS_TOKEN=
QBO_SANDBOX_ENTITY=
QBO_SANDBOX_PREPAID_ACCOUNT_ID=
QBO_SANDBOX_EXPENSE_ACCOUNT_ID=

# Worker only: enable OpenAI interpretation by setting both values.
# Never use VITE_ names or expose this key to the API/frontend.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional encrypted provider connections and outbound private links.
# Generate separately with openssl rand -hex 32; keep identical on API and worker.
SECRETS_KEY=
# Offline rotation command only. Never forward to API, edge or worker containers.
SECRETS_KEY_PREVIOUS=
# Optional server-only operations webhook; the worker sends bounded IDs and state only.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
# Exact public HTTPS SPA origin; required only for approved email delivery.
PUBLIC_APP_URL=

# Optional client-specific QuickBooks sandbox OAuth (server only).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Exact HTTPS API URL ending /v1/quickbooks/callback, registered in Intuit.
QBO_REDIRECT_URI=
# Optional Cloudflare Email Routing address; enable subaddressing and route the base address to the edge Worker.
EMAIL_INTAKE_ADDRESS=
# Separate random server secret (at least 32 characters); shared by edge and API only.
EMAIL_INTAKE_KEY=
QBO_PRODUCTION_CLIENT_ID=
QBO_PRODUCTION_CLIENT_SECRET=
QBO_PRODUCTION_REDIRECT_URI=

# Required for client attachment scanning. No local bypass.
# See docs/cloudflare-upload-scanning.md before setting these.
UPLOAD_SCAN_HOST=
UPLOAD_SCAN_KEY=

# Native API only; Compose sets its private scanner URL automatically.
TEXT_SCANNER_URL=
