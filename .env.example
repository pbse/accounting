# Generate a private value: openssl rand -hex 32
WORKSPACE_TOKEN=
# Native Go development only; Compose supplies its own internal database URL.
DATABASE_URL=postgres://close:local-development-only@127.0.0.1:5432/close?sslmode=disable
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional hosted login. When enabled, the development token is not accepted.
WORKOS_CLIENT_ID=
WORKOS_API_HOSTNAME=
# Optional single-organization restriction and legacy sandbox owner.
# Leave empty for multi-firm SaaS; register allowed organizations in the database.
WORKOS_ORGANIZATION_ID=
# Exact iss claim configured for your WorkOS application; do not guess.
WORKOS_ISSUER=
# Platform staff (admin panel, /admin; docs/admin-panel.md): everyone with a verified Google address at this domain,
# e.g. getkrith.com, with every platform permission. Needs AUTH_SESSION=server; with WorkOS and no domain, the staff
# console answers 503.
STAFF_EMAIL_DOMAIN=
# Worker only: Krith's own emails to people at firms, a welcome when someone sets up a firm by signing in and a note
# when a colleague joins (docs/sign-in.md#welcome-emails). PLATFORM_EMAIL_KEY is a send-only Resend key for the
# sender's verified domain; PLATFORM_EMAIL_FROM is the sender, e.g. Krith <hello@mail.getkrith.com>. Without both,
# nothing is sent. Links use PUBLIC_APP_URL.
PLATFORM_EMAIL_KEY=
PLATFORM_EMAIL_FROM=
# Optional, API only: turns on "Add from Google Drive" through WorkOS Pipes (google-drive, read-only drive.readonly scope
# approved in the WorkOS dashboard). Needs PUBLIC_APP_URL for the return after connecting. Never expose to the frontend.
WORKOS_API_KEY=
# Sandbox only; obtain a short-lived access token from the Intuit developer playground.
# Expired tokens stop operations; this initial sandbox slice does not refresh OAuth tokens.
QBO_SANDBOX_REALM_ID=
QBO_SANDBOX_ACCESS_TOKEN=
QBO_SANDBOX_ENTITY=
QBO_SANDBOX_PREPAID_ACCOUNT_ID=
QBO_SANDBOX_EXPENSE_ACCOUNT_ID=

# API and worker: enable OpenAI interpretation by setting both values.
# Never use VITE_ names or expose this key to the frontend.
OPENAI_API_KEY=
# Explicit effort for reasoning-capable API models; leave empty for provider default.
OPENAI_REASONING_EFFORT=
# Optional purpose-to-effort JSON overrides, analogous to LLM_MODELS.
LLM_REASONING_EFFORTS=
OPENAI_MODEL=
# Optional purpose-specific models, e.g. {"preparation":"model-name","work_command":"model-name"}.
LLM_MODELS=
# All accounting calls: api (default) or context_machine. Research always uses the service.
LLM_PROVIDER=api
# Explicit acknowledgement: Codex subscription cannot enforce an output-token ceiling.
LLM_ALLOW_UNCAPPED_OUTPUT_TOKENS=false
# Completion caller identities; match the service profiles exactly.
CONTEXT_MACHINE_PROFILES=
CODEX_MODEL=
CLAUDE_MODEL=
CODEX_REASONING_EFFORT=medium
CLAUDE_REASONING_EFFORT=medium
# Both token and agent are required to enable the context machine.
# Cloudflare uses a private service binding; no public URL is required.
# Host-run Go processes can use a local runner: http://127.0.0.1:8081/v1/run.
# Docker Compose processes cannot reach the host through loopback; use a
# reachable private HTTPS endpoint when running the API/worker in containers.
# Endpoint overrides belong to deployment configuration only. No browser exposure.
CONTEXT_MACHINE_TOKEN=
CONTEXT_MACHINE_MODEL=
CONTEXT_MACHINE_ENDPOINT=

# Optional encrypted provider connections and outbound private links.
# Generate separately with openssl rand -hex 32; keep identical on API and worker.
SECRETS_KEY=
# Offline rotation command only. Never forward to API, edge or worker containers.
SECRETS_KEY_PREVIOUS=
# Optional server-only operations webhook; the worker sends bounded IDs and state only.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
# Exact public HTTPS SPA origin; required for approved email delivery and Google Drive connections.
PUBLIC_APP_URL=

# Optional client-specific QuickBooks sandbox OAuth (server only).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Exact HTTPS API URL ending /v1/quickbooks/callback, registered in Intuit.
QBO_REDIRECT_URI=
# Optional Intuit webhook verifier token; enables change hints at /v1/webhooks/quickbooks.
QBO_WEBHOOK_VERIFIER=
# Optional Xero OAuth app (server only); writes require a separate reviewed posting grant. Exact HTTPS API URL ending /v1/xero/callback, registered in Xero.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Optional Xero webhook signing key; enables change hints at /v1/webhooks/xero.
XERO_WEBHOOK_KEY=
# Optional Cloudflare Email Routing address; enable subaddressing and route the base address to the edge Worker.
EMAIL_INTAKE_ADDRESS=
# Separate random server secret (at least 32 characters); shared by edge and API only.
EMAIL_INTAKE_KEY=
QBO_PRODUCTION_CLIENT_ID=
QBO_PRODUCTION_CLIENT_SECRET=
QBO_PRODUCTION_REDIRECT_URI=

# Required for client attachment scanning. No local bypass.
# See docs/cloudflare-upload-scanning.md before setting these.
UPLOAD_SCAN_HOST=
UPLOAD_SCAN_KEY=

# Native API only; Compose sets its private scanner URL automatically.
TEXT_SCANNER_URL=

# Context-machine service only. Never expose these credentials to API/queue or browsers.
CODEX_MODEL=
CLAUDE_MODEL=
CODEX_REASONING_EFFORT=medium
CLAUDE_REASONING_EFFORT=medium
# auto prefers API key; subscription requires the corresponding CLI token.
CODEX_AUTH_MODE=auto
CLAUDE_AUTH_MODE=auto
CODEX_ACCESS_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
