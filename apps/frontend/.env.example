# Leave empty for the local Vite proxy / same-origin Cloudflare ingress.
# Or use an independently hosted backend origin, e.g. http://127.0.0.1:8080
# The backend must allow the frontend origin through FRONTEND_ORIGIN.
VITE_API_BASE_URL=

# Public WorkOS application identifiers only. Never put API keys here.
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_API_HOSTNAME=
