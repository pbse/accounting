{
  "name": "close-preparation",
  "private": true,
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up --build --watch",
    "dev:frontend": "npm run dev -w @close/frontend",
    "build": "npm run build -w @close/frontend",
    "check": "npm run check --workspaces --if-present",
    "test": "node --experimental-strip-types --test workers/queue/src/delivery.test.ts workers/edge/src/upload-scan.test.ts apps/frontend/src/features/dashboard/commands.test.ts apps/frontend/src/features/closes/citation.test.ts",
    "check:go": "cd services/backend && go test ./... && go vet ./...",
    "dev:cloudflare": "npm run build && wrangler dev -c workers/edge/wrangler.jsonc",
    "deploy:staging": "npm run build && wrangler deploy -c workers/edge/wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "4.136.1",
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/node": "^24.0.0"
  }
}
